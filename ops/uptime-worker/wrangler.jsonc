{
  // aquapado 외부 감시 Worker — 매분 공개 사이트 접속 확인 → ntfy. 배포: npx wrangler@4 deploy
  "name": "aquapado-uptime",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-01",
  "triggers": { "crons": ["* * * * *"] },
  "kv_namespaces": [{ "binding": "UPTIME", "id": "602982a562b5433ca47a757c0002a83e" }],
  "observability": { "enabled": true }
  // 비밀값(wrangler secret put): NTFY_TOPIC(휴대폰이 구독 중인 ntfy 토픽), RUN_KEY(수동 실행 /run?key=)
}
