# Cloudflare Pages 헤더 규칙 — deploy_landing.ps1 이 배포 직전에 스테이징 폴더 루트로 복사한다(landing/ 에는 두지 않음:
# Vercel 에서는 이 파일이 그대로 공개 파일로 서빙되므로).
# vercel.json 의 headers 두 개를 옮긴 것 + pages.dev 주소는 검색 색인 금지(같은 내용이 두 주소로 잡히지 않게).

/*.png
  Cache-Control: public, max-age=604800, immutable
/*.jpg
  Cache-Control: public, max-age=604800, immutable
/*.jpeg
  Cache-Control: public, max-age=604800, immutable
/*.svg
  Cache-Control: public, max-age=604800, immutable
/*.ico
  Cache-Control: public, max-age=604800, immutable
/*.webmanifest
  Cache-Control: public, max-age=604800, immutable

/sitemap.xml
  Content-Type: application/xml; charset=utf-8

https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
